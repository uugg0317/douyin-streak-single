# 抖音续火花 2.8 · 本机无密码门版
# 可选配置模板，不含登录态、邮箱授权码或管理凭据。
# 复制为 .env 后仅在本机使用；不要提交 .env 或 data/。

# 只允许回环地址。此版本不提供公网、局域网或反向代理入口。
HOST=127.0.0.1
PORT=8000

# 首次使用保持后台任务暂停，手动操作由控制台发起。
SPARKKEEPER_BACKGROUND_TASKS=0
# 仅在显式启用后台任务后生效：错过当天时间的补跑检查。
CATCH_UP_MISSED_RUN=on

# 面板内显示二维码；手机确认后自动保存本机凭证。
COOKIE_EXTRACT_MODE=local-client
# 留空时 Windows 优先使用已安装的 Edge，否则使用 Playwright Chromium。
# 可选 msedge / chrome / chromium。扫码浏览器在后台运行。
QR_LOGIN_BROWSER_CHANNEL=
QR_LOGIN_NETWORK_MODE=auto

TZ=Asia/Shanghai

# 可选登录态预警；实际邮件仍需在控制台配置自己的邮箱。
# SESSION_WARN_EMAIL_ENABLED=on

# 可选：浏览器预热与复用。后台任务暂停时不会自动预热。
# PREWARM_LEAD_MINUTES=2
# KEEP_PREWARMED_SECONDS=600
# KEEP_BROWSER_ALWAYS=true
# BROWSER_MAX_IDLE_SECONDS=600

# 可选：未配置发送间隔时的兜底值，优先使用后台生效配置。
# SEND_INTERVAL_MIN=1.0
# SEND_INTERVAL_MAX=4.0

# 可选：把运行事件 POST 到 Grok Bot Webhook 例程。留空则不发送。
# GROK_BOT_WEBHOOK_URL 填例程面板给出的完整 POST 地址，不要写进仓库。
# GROK_BOT_WEBHOOK_KEY 填发送密钥。请求同时带 Authorization: Bearer 与 X-Webhook-Key。
# GROK_BOT_WEBHOOK_URL=
# GROK_BOT_WEBHOOK_KEY=
# 可选：相同事件的最短间隔（秒），默认 600。设为 0 表示不合并。
# watchdog_stuck、test_ping 与 assistant_message 不受此间隔限制。
# GROK_BOT_WEBHOOK_DEBOUNCE_SECONDS=600

# 可选：小号聊天助手。默认关闭。用另一个抖音号收私信并转给 Webhook，
# 回复只从该小号发出，不使用主号火花会话。
# ASSISTANT_INBOX_ENABLED=0
# 轮询间隔（秒），默认 90，小于 60 会按 60 处理。
# ASSISTANT_POLL_SECONDS=90
# 允许转发和回复的昵称或 ID，英文逗号分隔。为空则不转发、不回复、不打开小号浏览器。
# ASSISTANT_ALLOWED_SENDERS=
# 可选：每轮向该地址 GET 待发回复 [{id,to,text}]，成功后 POST {"ack":[...]}。留空则关闭。
# ASSISTANT_REPLY_PULL_URL=
# ASSISTANT_REPLY_PULL_KEY=
