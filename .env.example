# 可选本机配置：复制为 .env 后可填写 SMTP 等个人设置。
# .env 和 data/ 不随公开仓库或桌面产物分发。

# 面板直接打开即可使用，无管理员登录门。后端保持回环监听。
# 默认本机使用；经同机反代访问时需显式配置下方外部来源，并自行限制后台访问范围。
HOST=127.0.0.1
PORT=8000
# 可选：首次模拟演练时可取消下一行注释，暂停后台任务；通常沿用现有开关与配置。
# SPARKKEEPER_BACKGROUND_TASKS=0
TZ=Asia/Shanghai

# 留空使用本机同源校验。反代时填写与地址栏一致的协议、主机及非默认端口。
# 不含路径、查询参数或末尾斜杠；此配置不是访问凭据。
# QR_PUBLIC_ORIGIN=https://example.com
QR_PUBLIC_ORIGIN=

# 当前面板内嵌二维码扫码；旧独立助手接口仅用于兼容。
COOKIE_EXTRACT_MODE=local-client
# 留空时 Windows 优先使用已安装 Edge；也可选择 msedge / chrome / chromium。
QR_LOGIN_BROWSER_CHANNEL=
QR_LOGIN_NETWORK_MODE=auto

# 可选邮件设置。未配置时无需填写；可在本机面板的邮件设置中编辑。
# SMTP_PASS 填邮箱服务商提供的授权码，不要提交真实值。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# 登录态临期/失效提醒开关；不影响看门狗卡死提醒。
# SESSION_WARN_EMAIL_ENABLED=on

# 实际发送间隔以面板配置为准，以下仅作为缺失时的兜底。
# SEND_INTERVAL_MIN=1.0
# SEND_INTERVAL_MAX=4.0

# 可选浏览器预热/常驻选项；未设置时沿用原有默认值。
# KEEP_PREWARMED_SECONDS=600
# KEEP_BROWSER_ALWAYS=true
# BROWSER_MAX_IDLE_SECONDS=900
