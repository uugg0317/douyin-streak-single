# 抖音续火花 2.8 · 本机无密码门版
# 可选配置模板，不含登录态、邮箱授权码或管理凭据。
# 复制为 .env 后仅在本机使用；不要提交 .env 或 data/。

# 只允许回环地址。此版本不提供公网、局域网或反向代理入口。
HOST=127.0.0.1
PORT=8000

# 首次使用保持后台任务暂停，手动操作由控制台发起。
SPARKKEEPER_BACKGROUND_TASKS=0
# 仅在显式启用后台任务后生效：错过当天时间的补跑检查。
CATCH_UP_MISSED_RUN=on

# 面板内显示二维码；手机确认后自动保存本机凭证。
COOKIE_EXTRACT_MODE=local-client
# 留空时 Windows 优先使用已安装的 Edge，否则使用 Playwright Chromium。
# 可选 msedge / chrome / chromium。扫码浏览器在后台运行。
QR_LOGIN_BROWSER_CHANNEL=
QR_LOGIN_NETWORK_MODE=auto

TZ=Asia/Shanghai

# 可选登录态预警；实际邮件仍需在控制台配置自己的邮箱。
# SESSION_WARN_EMAIL_ENABLED=on

# 可选：浏览器预热与复用。后台任务暂停时不会自动预热。
# PREWARM_LEAD_MINUTES=2
# KEEP_PREWARMED_SECONDS=600
# KEEP_BROWSER_ALWAYS=true
# BROWSER_MAX_IDLE_SECONDS=600

# 可选：未配置发送间隔时的兜底值，优先使用后台生效配置。
# SEND_INTERVAL_MIN=1.0
# SEND_INTERVAL_MAX=4.0
