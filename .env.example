# ============================================================================
# 复制本文件为 .env 后填写真实值：  cp .env.example .env
# .env 已在 .gitignore 里，**永远不要提交**
# ============================================================================

# ── Web 服务监听 ────────────────────────────────────────────────────────────
# 只监听回环地址，由 nginx 反代出去。除非你清楚风险，否则不要改成 0.0.0.0。
PORT=8000
HOST=127.0.0.1

# 旧本机助手兼容项；当前面板扫码使用内嵌二维码，不再依赖独立助手。
COOKIE_EXTRACT_MODE=local-client

# 本机使用留空。若经 HTTPS 域名反向代理访问，填写该面板的完整 Origin。
QR_PUBLIC_ORIGIN=
# 留空时 Windows 自动优先使用已安装 Edge，否则使用 Playwright Chromium。
# 可选：msedge / chrome / chromium。始终后台运行，不弹登录窗口。
QR_LOGIN_BROWSER_CHANNEL=
QR_LOGIN_NETWORK_MODE=auto

# ── 登录门总开关 ────────────────────────────────────────────────────────────
# on （默认）| off
#
# off = 不做任何鉴权，打开网页直接进后台，下面那些凭据全部用不上。
#       适合「只在自己电脑上跑、不对外」的场景。
#
#       ⚠️ 两个前提，缺一不可：
#       1. 服务必须只监听回环地址。off 时如果 HOST 不是 127.0.0.1 / localhost /
#          ::1，程序会**拒绝启动**（这是硬性检查，不是提醒）。
#       2. 要清楚关锁的后果：任何能连上这个端口的人都能点「立即续火花」，
#          给你真实好友发消息，不可撤回。
#
#       登录页会用 AUTH_TOKEN 换取 HttpOnly 短期会话，令牌不会保存在 localStorage。
LOGIN_GATE=on

# ── 凭据（LOGIN_GATE=on 时才需要填） ────────────────────────────────────────
# 管理接口的请求头令牌（X-Auth-Token）。随便一串长随机字符串：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN=change_me_to_a_long_random_string

# URL + 密码入口令牌（推荐 https://你的域名/#access_token=...，fragment 不进日志）。
URL_ACCESS_TOKEN=

# 口令验证方式：salt 随便一串随机值，hash = sha256(口令 + salt) 的十六进制小写。
#   python -c "import hashlib,secrets; s=secrets.token_hex(16); print('SALT:',s); print('HASH:',hashlib.sha256(('你的口令'+s).encode()).hexdigest())"
# 生成后把 SALT 填到 URL_PASSWORD_SALT、HASH 填到 URL_PASSWORD_HASH。
# 口令本身不要写在这个文件里，自己单独记牢。
URL_PASSWORD_SALT=
URL_PASSWORD_HASH=

# 登录白名单 IP（逗号分隔）。留空 = 不启用。
# 一般不需要，直连时受信任的网络可以直接跳过口令。
WHITELIST_IPS=

# 登录态临期/掉线预警邮件开关（默认 on）。本机调试没有真实登录态时可设 off，
# 避免体检与手动运行误发告警邮件；看门狗卡死告警不受此开关影响。
# SESSION_WARN_EMAIL_ENABLED=on

# ── 其它 ────────────────────────────────────────────────────────────────────
TZ=Asia/Shanghai

# ── 可选：发送间隔兜底（秒） ────────────────────────────────────────────────
# 实际间隔以管理后台里配置的发送间隔为准，这两个值只在配置缺失时兜底。
# SEND_INTERVAL_MIN=1.0
# SEND_INTERVAL_MAX=4.0

# ── 可选：浏览器预热与常驻 ─────────────────────────────────────────────────
# 冷启动 Chromium 约 20 秒。默认发送前 60 秒预启动，发完保留 600 秒供复用。
# KEEP_PREWARMED_SECONDS=600
#
# 常驻模式：浏览器永不主动关闭，冷启动彻底消除。适合长期挂机的服务器。
# KEEP_BROWSER_ALWAYS=true
#
# 预启动实例最大空闲秒数；0 = 永不过期。常驻模式下默认 0，否则默认 900。
# BROWSER_MAX_IDLE_SECONDS=900
