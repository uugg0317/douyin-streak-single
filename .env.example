# ============================================================================
# 首次本机使用请运行启动 BAT 设置密码；本模板不含任何可用凭据。
# .env 已在 .gitignore 里，**永远不要提交**
# ============================================================================

# ── Web 服务监听 ────────────────────────────────────────────────────────────
# 只监听回环地址，由 nginx 反代出去。除非你清楚风险，否则不要改成 0.0.0.0。
PORT=8000
HOST=127.0.0.1

# 旧本机助手兼容项；当前面板扫码使用内嵌二维码，不再依赖独立助手。
COOKIE_EXTRACT_MODE=local-client

# 本机使用留空。若经 HTTPS 域名反向代理访问，填写该面板的完整 Origin。
QR_PUBLIC_ORIGIN=
# 额外 API Host 白名单（逗号分隔精确主机名或 host:port，不支持通配符）。
# 留空只使用已有回环/QR_PUBLIC_ORIGIN入口；无端口项按主机名匹配，有端口项限定端口。
# 仅用于API入口别名，不能替代HTTPS反代的QR_PUBLIC_ORIGIN，也不会放宽扫码入口。
ALLOWED_HOSTS=
# 留空时 Windows 自动优先使用已安装 Edge，否则使用 Playwright Chromium。
# 可选：msedge / chrome / chromium。始终后台运行，不弹登录窗口。
QR_LOGIN_BROWSER_CHANNEL=
QR_LOGIN_NETWORK_MODE=auto

# ── 登录门总开关 ────────────────────────────────────────────────────────────
# 本独立副本默认开启密码门。首次使用请运行启动 BAT，由 password_setup.py
# 创建本机 .env、设置密码并生成随机令牌；不要直接复制空示例后启动。
LOGIN_GATE=on
# 普通登录页直接输入密码，无需先复制 URL 访问令牌。
PASSWORD_PUBLIC_LOGIN=on
# 不允许通过无门模式公开后台。
ALLOW_PUBLIC_NO_GATE=off
# 本机首轮检查暂停定时、自动采集和备份；手动操作仍由你在面板内选择。
SPARKKEEPER_BACKGROUND_TASKS=0
# 后台启用时，启动和 12:30 体检后检查今天是否漏跑；默认 on。
# 达到配置发送时间后两分钟、今天没有真实运行记录且任务空闲时，仅启动一次。
# 桌面不希望启动即补跑可设 off；后台总开关为 0 时本项不产生任何账号任务。
CATCH_UP_MISSED_RUN=on
# ── 凭据（LOGIN_GATE=on 时才需要填） ────────────────────────────────────────
# 管理接口的请求头令牌（X-Auth-Token）。随便一串长随机字符串：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN=

# URL + 密码入口令牌（推荐 https://你的域名/#access_token=<access-token>，fragment 不进日志）。
URL_ACCESS_TOKEN=

# 首次密码设置使用 scrypt$N$r$p$salt_hex$hash_hex，盐已包含在哈希中。
# 在源码目录显式生成（密码输入不回显，输出只有待保存的配置哈希）：
#   python -c "import getpass; from auth_config import hash_password; print('URL_PASSWORD_HASH='+hash_password(getpass.getpass('访问密码: ')))"
# 新 scrypt 配置把 URL_PASSWORD_SALT 留空；参数上限由 auth_config.py 校验，禁止任意提高开销。
# 旧 SHA-256(口令+salt) 的 64 位十六进制哈希仍可用，保留原 SALT。
# 正常登录验证成功后尝试原子迁移到 scrypt，密码内容不变；迁移失败仍保留旧格式和本次成功登录。
# 原始口令不要写在这个文件里，自己单独记牢。
URL_PASSWORD_SALT=
URL_PASSWORD_HASH=

# 登录白名单 IP（逗号分隔）。留空 = 不启用。
# 一般不需要，直连时受信任的网络可以直接跳过口令。
WHITELIST_IPS=

# ── 直接密码登录（本独立副本默认开启） ────────────────────────────────────────
# on = 直接打开域名（不带 #access_token=<access-token>）也显示访问密码框，只输密码即可登录。
#      此时口令务必 12 位以上且无规律；外部非白名单来源失败 10 次锁定 IP 30 分钟。
#      IPv4/IPv6 回环及白名单豁免失败计数锁定，仍受全局请求频率限制。
#      管理令牌入口仍保留在登录卡下方「使用管理令牌登录」。
# off = 仅管理令牌或带 URL 令牌的密码入口；本机密码门版请保持上方 on。
# PASSWORD_PUBLIC_LOGIN 已在上方设置为 on，请勿重复添加。

# 登录态临期/掉线预警邮件开关（默认 on）。本机调试没有真实登录态时可设 off，
# 避免体检与手动运行误发告警邮件；看门狗卡死告警不受此开关影响。
# SESSION_WARN_EMAIL_ENABLED=on

# ── 其它 ────────────────────────────────────────────────────────────────────
TZ=Asia/Shanghai

# ── 可选：发送间隔兜底（秒） ────────────────────────────────────────────────
# 实际间隔以管理后台里配置的发送间隔为准，这两个值只在配置缺失时兜底。
# SEND_INTERVAL_MIN=1.0
# SEND_INTERVAL_MAX=4.0

# ── 可选：浏览器预热与常驻 ─────────────────────────────────────────────────
# 默认发送前 2 分钟预启动，发完保留 600 秒供复用；后台暂停时不会自动预热。
# PREWARM_LEAD_MINUTES=2
# KEEP_PREWARMED_SECONDS=600
#
# 常驻模式：发送结束保留浏览器；空闲后的页面仍需刷新和复核，失败时重建。
# KEEP_BROWSER_ALWAYS=true
#
# 页面最大空闲秒数，默认 600（常驻模式相同）；超过先刷新、等待列表并复核登录。
# 显式设置 0 可关闭空闲刷新，但复用时仍检查登录；显式自定义值优先。
# BROWSER_MAX_IDLE_SECONDS=600
