# 可选：与后端在同一台机器上的 Nginx HTTPS 反代。
# 后端保持 HOST=127.0.0.1、PORT=8000；先设置
# QR_PUBLIC_ORIGIN=https://example.com 并重启后端。
# 替换示例域名和证书路径；有非默认外部端口时，来源配置需包含该端口。
# 面板无管理员登录门。使用者需自行限制后台的网络或代理访问范围。

server {
    listen 80;
    server_name example.com;
    return 301 https://example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name example.com;

    ssl_certificate /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    client_max_body_size 6m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 覆盖客户端自带的转发声明，不透传不可信的 X-Forwarded-For 链。
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
